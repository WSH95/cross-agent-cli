#!/bin/sh
# Codex starts this plugin's MCP server through this file, in the plugin's own directory
# (`.codex-plugin/plugin.json`, `cwd: "."`): codex-cli 0.159.3 substituted no `${PLUGIN_ROOT}`
# in an inline `command`, `args` or `cwd`, and runs a relative command from the server's
# working directory. That directory is Codex's cache copy of this repository, where discovery
# finds no project the operator meant: a copy of an export holds no `.git` and no config, so
# discovery finds nothing, and a copy of a checkout carries the checkout's `.git`, so
# discovery finds a repository the operator did not name — the copy itself, for a main
# checkout, or the checkout it was copied from, for a linked worktree. So the server serves
# the project the operator names in CROSS_AGENT_PROJECT, and without one it does not start.
if [ -z "${CROSS_AGENT_PROJECT:-}" ]; then
  echo "cross-agent: not started: under Codex this server runs in its plugin's directory and serves only the project CROSS_AGENT_PROJECT names; export CROSS_AGENT_PROJECT=<project root> before starting codex" >&2
  exit 1
fi
# A root that cannot be resolved stops here, rather than handing node `/src/server.ts`.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
exec node "$root/src/server.ts" "$@"
