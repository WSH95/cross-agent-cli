{
  "id": "dev-team-engine",
  "release": "0.1.0",
  "name": "Dev team, engine-placed lead",
  "summary": "The dev-team roles with the loop moved into a spawned Claude or Codex lead, so your own session stays free while the team works. The lead is read-only at the project root and reaches git and the test command through the server's root tools.",
  "lead": { "placement": "engine", "role": "lead" },
  "roles": [
    {
      "key": "lead",
      "title": "Lead",
      "promptFile": "roles/lead.md",
      "workspace": { "kind": "root" },
      "sandboxDefault": "read-only"
    },
    {
      "key": "planner",
      "title": "Planner",
      "promptFile": "roles/planner.md",
      "workspace": { "kind": "root" },
      "sandboxDefault": "read-only"
    },
    {
      "key": "plan-reviewer",
      "title": "Plan reviewer",
      "promptFile": "roles/plan-reviewer.md",
      "workspace": { "kind": "root" },
      "sandboxDefault": "read-only"
    },
    {
      "key": "implementer",
      "title": "Implementer",
      "promptFile": "roles/implementer.md",
      "workspace": { "kind": "worktree", "branchPattern": "task/*", "dir": ".worktrees" },
      "sandboxDefault": "workspace-write"
    },
    {
      "key": "code-reviewer",
      "title": "Code reviewer",
      "promptFile": "roles/code-reviewer.md",
      "workspace": { "kind": "worktree", "branchPattern": "task/*", "dir": ".worktrees" },
      "sandboxDefault": "read-only"
    }
  ],
  "git": { "worktreeDir": ".worktrees", "branchPattern": "task/*" },
  "requires": { "engines": [] }
}
